# Copy this file to .env.local and paste your key. Never commit .env.local.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: override the model
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: log visitors' questions to Kairo anonymously (read them with `npm run questions`).
# Create a free Redis database at https://console.upstash.com and copy its REST URL and token.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
