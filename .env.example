# Copy this file to .env and fill in your values. .env is git-ignored; never commit it.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: override the model
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: log visitors' questions to Kairo anonymously (read them with `npm run questions`).
# Create a free Redis database at https://console.upstash.com and copy its REST URL and token.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional (needs the Upstash keys above): limits shared by every serverless instance. Each visitor
# gets 25 questions per 10 minutes; GROQ_DAILY_CAP is the most questions all visitors together may
# ask per UTC day. Set it to about 80% of your Groq model's real daily limit (default 1000).
# GROQ_DAILY_CAP=1000
